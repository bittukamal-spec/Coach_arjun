# ─────────────────────────────────────────────────────────────
# MindGame Client — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# The name shown in the browser tab / header
VITE_APP_NAME=MindGame

# ── Push Notifications (Web Push / VAPID) ─────────────────────
# Public VAPID key — safe to expose to the browser bundle (it identifies
# the server to push services, same role as VITE_RAZORPAY_KEY_ID below).
# Must match VAPID_PUBLIC_KEY on the server exactly.
VITE_VAPID_PUBLIC_KEY=
