// Arjun — AI Mental Coach Database Schema
// Run `npm run db:migrate` to apply changes
// Run `npm run db:studio` to open a visual database browser

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String?  @unique  // kept optional for potential future re-addition
  email     String   @unique
  name      String
  password  String?            // bcrypt hash — null for any legacy Google accounts
  avatar    String?

  // "free" = 14-day trial, then blocked
  // "premium" = full access (₹299/month)
  tier         String    @default("free")
  trialStarted DateTime?  // set on registration; 14-day trial window

  // Pilot beta entitlement — grants Coach/chat + the same AI-gated
  // experiences (Debrief insight, Weekly Reports, session summaries, Mind
  // Journal review, Self-Talk, Body Reset) an active trial or premium
  // tier already grants, independent of tier/billing. Founder-granted only
  // (Founder Pilot Dashboard's Pilot tab) — never set by signup, onboarding,
  // or any athlete-facing action. Null = no pilot grant. A non-null value in
  // the past is simply an expired grant, not a flag to be unset; nothing
  // ever infers pilot membership from these fields other than a plain
  // `pilotAccessUntil > now` check (server/src/routes/chat.js's
  // checkFreeLimit/isTrialActive). Additive fields — existing rows default
  // to null on migration, no backfill, no automatic grant.
  pilotAccessUntil    DateTime? // null = no pilot access; must be in the future to count as active
  pilotAccessGrantedAt DateTime? // when the current/most recent grant was made, for the founder's own reference — not read by entitlement logic

  // "en" = English, "hi" = Hindi
  language  String   @default("en")

  // Onboarding — collected after first login
  sport           String?          // e.g. "cricket", "badminton"
  experienceLevel String?          // "beginner" | "amateur" | "competitive" | "professional"
  goals           String  @default("[]") // JSON array e.g. '["focus","confidence"]'
  onboardingDone  Boolean @default(false)

  // Extended onboarding fields
  competitionLevel  String?   // "recreational" | "local" | "state" | "national" | "international"
  primaryChallenge  String?   // "nerves" | "failure" | "focus" | "family_pressure" | "injury" | "consistency"
  pressureResponse  String?   // "has_routine" | "talks_to_others" | "ignores_it" | "struggles" | "unaware"
  position          String?   // free text, e.g. "batsman", "goalkeeper"

  // Pre-match ritual
  ritualName    String?
  ritualSteps   String  @default("[]") // JSON: [{type, label}]

  // WhatsApp / notifications (Sprint 2)
  phone         String?           // "+917012345678"
  reminderOptIn Boolean  @default(false)

  // Razorpay subscription
  razorpaySubscriptionId  String?
  razorpayCustomerId      String?
  subscriptionPlanType    String?   // "monthly" | "yearly"
  subscriptionStartDate   DateTime?
  subscriptionEndDate     DateTime?

  // Gamification
  xp                  Int       @default(0)
  streakFreezeCount   Int       @default(1)
  lastFreezeUsedAt    DateTime?

  // OCEAN Big Five personality (1–5 scale, null = not taken yet)
  oceanO        Int?   // Openness
  oceanC        Int?   // Conscientiousness
  oceanE        Int?   // Extraversion
  oceanA        Int?   // Agreeableness
  oceanN        Int?   // Neuroticism

  // Mental Game Profile intro (AI-generated, cached after onboarding)
  profileIntro  String?

  // Before You Play — saved cue word
  cueWord         String?
  cueLanguage     String?
  cueArousalState String?   // "calm_down" | "lock_in" | "fire_up"
  cueEventType    String?   // "before_match"
  cueUpdatedAt    DateTime?

  // Demographics
  age           Int?   // age in years

  // Minor-user compliance (DPDP) — set at registration
  dateOfBirth           DateTime? // null for accounts created before the age gate
  guardianEmail         String?   // required at signup when under 18
  guardianConsentAt     DateTime? // set when guardian confirms via emailed link
  // TODO: restore @unique once this project moves to tracked Prisma
  // migrations — db push on a populated User table requires
  // --accept-data-loss to add a new unique constraint, which we're
  // avoiding for production `start`. Token is still effectively unique
  // in practice (crypto.randomBytes(32) — see auth.js), just not
  // DB-enforced right now. Lookup uses findFirst, not findUnique.
  guardianConsentToken  String?   // one-time consent-link token

  // Mind Journal — score-free, opt-in-only Arjun context (Mental Fitness
  // scoring replacement rollout). Default false for existing and new users.
  mindJournalContextEnabled Boolean @default(false)

  // Pilot Tracking Phase 2A — timestamp of the athlete's most recent
  // meaningful, authenticated product write (Coach message, onboarding
  // progress, Mental Rep, Mind Journal entry, Focus Card, Body Reset,
  // Debrief, Ritual, skill practice, game session — see
  // services/activityTracking.js for the exact list). Deliberately NOT a
  // generic "last seen" — GET requests, page loads, login, settings edits,
  // and founder/admin/payment/webhook activity never touch this. Null for
  // an athlete with no qualifying activity yet (including pre-Phase-2A
  // accounts before the one-time backfill runs). No default, no index —
  // Phase 2A only reads/writes it via primary key lookups.
  lastActiveAt DateTime?

  // Pilot Presence Tracking — timestamp of the athlete's most recent
  // "Arjun is open/visible" heartbeat (see routes/activity.js's presence
  // touch + client/src/hooks/usePresenceHeartbeat.js). Deliberately the
  // OTHER signal from lastActiveAt above: this updates on mere app
  // presence (load, foreground return, ~60s while visible) and carries no
  // meaning about whether the athlete did anything. Never read by
  // activityTracking.js; never written by touchActivity(). Null for an
  // athlete who has never had the app open since this field shipped. No
  // default, no index — read via primary-key lookups and one bounded
  // full-table scan in founderPilotOverview.js, same pattern lastActiveAt
  // already uses.
  lastSeenAt DateTime?

  messages               Message[]
  safetyEvents           SafetyEvent[]
  checkIns               CheckIn[]
  memories               UserMemory[]
  passwordResets         PasswordResetToken[]
  achievements           UserAchievement[]
  drillCompletions       DrillCompletion[]
  debriefs               Debrief[]
  gameSessions           GameSession[]
  chatSessions           ChatSession[]
  mentalFitnessEntries   MentalFitnessEntry[]
  toolReports            ToolReport[]
  weeklyReports          WeeklyReport[]
  selfTalkCards          SelfTalkCard[]
  bodyResetSessions      BodyResetSession[]
  skillProgress          SkillProgress[]
  plans                  Plan[]
  coachingState            UserCoachingState?
  coachingCycles           CoachingCycle[]
  prescriptions            Prescription[]
  activeCoachingSelections ActiveCoachingSelection[]
  mindJournalEntries       MindJournalEntry[]
  onboardingSessions       OnboardingSession[]
  startingProfiles         StartingPerformanceProfile[]
  currentCoachingFocus     CurrentCoachingFocus?
  pilotCommunicationTargets   PilotCommunicationTarget[]
  pilotCommunicationResponses PilotCommunicationResponse[]
  pushNotificationPreference  PushNotificationPreference?
  pushSubscriptions           PushSubscription[]
  founderEmailDeliveries      FounderEmailDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CheckIn {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mood        Int      // 1–5
  focus       Int      // 1–5
  confidence  Int      // 1–5
  energy      Int?     // 1–5: how physically/mentally energised the athlete feels
  sleep       String?  // "poor" | "ok" | "great"
  reflection  String?  // optional free-text, max 500 chars
  gratitude   String?  // optional: one win from today, max 300 chars
  type        String   @default("checkin")   // "checkin" | "freeze"
  createdAt   DateTime @default(now())
}

model Message {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          String       // "user" | "assistant"
  content       String
  sessionType   String?      // "match_prep" | "post_match" | "build_focus" | "confidence" | "handle_pressure" | "open" | "post_checkin"
  chatSessionId String?
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id])
  createdAt     DateTime     @default(now())
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memKey    String   // e.g., "fear", "strength", "background", "pattern", "trigger"
  value     String   // e.g., "freezes before penalty kicks"
  source    String   @default("chat") // "chat" | "onboarding"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, memKey])
}

model UserAchievement {
  id       String   @id @default(cuid())
  userId   String
  key      String   // e.g. "first_checkin", "streak_7"
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model DrillCompletion {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  drillIndex  Int
  completedAt DateTime @default(now())
}

model Debrief {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wentWell       String   // max 500 chars (legacy text; new flow populates from chips)
  doDifferently  String   // max 500 chars (legacy text; new flow populates from wouldChange chip)
  nextFocus      String   // max 300 chars (chip label or free text)
  arjunInsight   String?  // AI-generated coaching insight
  // ── Structured fields added for quick/full mode rebuild ───────────────────
  mode            String?  // "quick" | "full"
  eventType       String?  // "Match" | "Tournament" | "Trial / Selection" | etc.
  resultType      String?  // one of the result chip labels
  wentWellChips   String?  // JSON array of chip labels e.g. '["Effort","Focus"]'
  wentWellText    String?  // optional typed text (full mode only, max 80 chars)
  wouldChange     String?  // single chip label from Screen 3
  wouldChangeText String?  // optional typed text (full mode only, max 80 chars)
  cueWordFeedback String?  // "helped" | "forgot" | "no_help"
  sport           String?  // snapshot of user.sport at time of debrief
  xpAwarded       Int?     // 15 quick / 20 full (legacy entries = 10)
  createdAt      DateTime @default(now())
}

model GameSession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType    String   // "grid" | "stroop" | "reaction" | "thought" | "filter"
  score       Int
  completedAt DateTime @default(now())
}

model ChatSession {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionType String    @default("general")
  mode        String    @default("main") // "main" | "quick"
  title       String?
  summary     String?
  status      String    @default("active") // "active" | "ended"
  createdAt   DateTime  @default(now())
  endedAt     DateTime?
  messages    Message[]

  // Optional origin reference for a coaching cycle/prescription that was
  // opened during this session (PR-8). Nullable on the child side — see
  // CoachingCycle.sourceChatSession / Prescription.sourceChatSession.
  coachingCycles CoachingCycle[]
  prescriptions  Prescription[]

  // The starting-profile first coaching conversation (PR 3), if this session
  // is that one. Nullable back-relation of StartingPerformanceProfile.firstChatSession.
  startingProfileFirstChat StartingPerformanceProfile?

  @@index([userId, mode])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MentalFitnessEntry {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String   // "YYYY-MM-DD" IST — avoids UTC midnight bug
  mood           Int?     // 1–5 (mood card, optional for back-compat)
  focus          Int      // 1–5
  confidence     Int      // 1–5
  drive          Int      // 1–5
  calm           Int      // 1–5
  selftalk       Int      // 1–5
  bounce         Int      // 1–5
  arjunResponse  String?  // AI-generated 1-liner, nullable
  createdAt      DateTime @default(now())

  @@unique([userId, date])
}

// Score-free Mind Journal (replaces the visible Mental Fitness scoring
// experience). Deliberately no score/rating/percentage/level/streak/XP/
// reward/aggregate field, and no automatic-interpretation or AI-generated
// summary field — states + an optional note are the athlete's own words.
// MentalFitnessEntry above is untouched and kept temporarily for
// compatibility; this is a separate, additive model.
model MindJournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  states    String[]
  note      String?
  createdAt DateTime @default(now())

  // Additive guided-reflection fields (PR 1 of the Mind Journal redesign).
  // All nullable — existing rows have entryType null and are treated as
  // legacy quick notes; no back-compat break, no destructive migration.
  entryType         MindJournalEntryType?
  contextType       MindJournalContextType?
  whatHappened      String?
  whatNoticed       String?
  helpedOrGotInWay  String?
  takeForward       String?

  // Optional athlete-authored state label ("Something else"). Kept separate
  // from the fixed `states` vocabulary — never stored inside that array.
  // Not yet included in Coach context (loadMindJournalContext).
  customState       String?

  // Optional athlete-authored context label when contextType is
  // SOMETHING_ELSE. The enum stays fixed; free text lives here.
  // Not yet included in Coach context (loadMindJournalContext).
  customContext     String?

  // ── Unified Mind Journal reflection (PR 1) ────────────────────────────
  // All additive and nullable / empty-list by default. Rows written by the
  // earlier shapes (legacy null entryType, QUICK_NOTE, GUIDED_REFLECTION)
  // keep every value they already have and simply carry empty lists here.
  // Written only by entryType REFLECTION.
  eventTags         String[]   // Q2 — observable events, max 2
  customEvent       String?    // Q2 "Write my own"
  thoughtTags       String[]   // Q4 — what was going through their mind, max 2
  customThought     String?    // Q4 "Write my own"
  responseTags      String[]   // Q5 — what they did, max 2
  customResponse    String?    // Q5 "Write my own"
  bodyTags          String[]   // Q6 body variant, max 2
  customBody        String?    // Q6 body "Write my own"
  cueFeedback       String?    // Q6 cue variant — "helped" | "forgot" | "no_help"
  cueWordSnapshot   String?    // the Focus Card word the cue question asked about

  // Arjun's Review — generated server-side after a successful save, never
  // by the athlete. Null when the review was skipped (trial) or failed;
  // the reflection itself is always kept regardless.
  arjunNoticed      String?
  arjunTakeaway     String?
  arjunPattern      String?    // null unless there was enough prior evidence
  reviewGeneratedAt DateTime?

  @@index([userId, createdAt])
}

enum MindJournalEntryType {
  QUICK_NOTE
  GUIDED_REFLECTION
  // Unified Mind Journal reflection (PR 1). Deliberately its OWN value
  // rather than overloading GUIDED_REFLECTION, so historical guided rows
  // stay distinguishable in history, detail rendering and Coach context.
  REFLECTION
}

enum MindJournalContextType {
  TRAINING
  COMPETITION
  TOUGH_MOMENT
  // RECOVERY_DAY is superseded by RECOVERY_INJURY for new reflections but is
  // NEVER removed — historical guided rows still carry it.
  RECOVERY_DAY
  SOMETHING_ELSE
  // ── Additive contexts for the unified reflection (PR 1) ───────────────
  WENT_WELL
  CONFIDENCE_PRESSURE
  SELECTION_TRIAL
  RECOVERY_INJURY
  OUTSIDE_SPORT
}

model ToolReport {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolType       String   // "bounce_back" | "visualization" | "debrief" | "cue_word"
  skillKey       String?  // "focus_self_talk" | "calm_body" | "reflection" | "visualization" | "mistake_reset" | "confidence"
  summary        String   // 1–2 sentence human-readable summary of what was done
  arjunResponse  String?  // Arjun's closing line shown to athlete
  details        String   @default("{}") // JSON blob of tool-specific fields
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

// Tracks per-skill recommendation/completion state for the chat
// recommendation loop. learnCompletedAt/quickCheckPassedAt are reserved
// for a future Learn/Quick-Check flow and are not written yet — MVP only
// uses toolCompletedAt/practiceCompletedAt/lastRecommendedAt.
model SkillProgress {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillKey            String    // focus_self_talk | calm_body | reflection | visualization | mistake_reset | confidence
  learnCompletedAt    DateTime?
  quickCheckPassedAt  DateTime?
  toolCompletedAt     DateTime?
  practiceCompletedAt DateTime?
  lastRecommendedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, skillKey])
}

model WeeklyReport {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart    DateTime // Monday 00:00:00 UTC
  weekEnd      DateTime // Sunday 23:59:59 UTC
  content      String   // Full report text with **bold** section headings
  messageCount Int      // User messages that week (for generation threshold)
  createdAt    DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model SelfTalkCard {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport                  String?
  roleOrPosition         String?
  performanceMoment      String?
  skillContext           String?
  situationCategory      String
  situationText          String?
  oldThought             String
  thoughtIntensityBefore Int?
  confidenceBefore       Int?
  confidenceAfter        Int?
  focusWord              String
  resetWord              String
  powerLine              String
  performanceReminder    String
  arjunNote              String
  safetyFlag             String    @default("safe")
  aiModel                String?
  tags                   Json?
  isActive               Boolean   @default(true)
  isMatchDayCard         Boolean   @default(false)
  matchDayContext        String?
  isArchived             Boolean   @default(false)
  usedCount              Int       @default(0)
  lastUsedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId, isActive, createdAt])
  @@index([userId, isArchived])
}

// Webhook idempotency — one row per processed Razorpay event (x-razorpay-event-id).
model ProcessedWebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  eventType String?
  createdAt DateTime @default(now())
}

// Founder review lifecycle for a SafetyEvent (PR-6). A constrained enum,
// not free text — the review workflow never accepts an arbitrary status.
enum SafetyReviewStatus {
  UNREVIEWED
  REVIEWED
}

// Founder review outcome (PR-6). Deliberately a small fixed set, not free
// text — there is no founder-notes field anywhere on this model.
enum SafetyReviewOutcome {
  NO_ACTION
  FOLLOW_UP_REQUIRED
  ESCALATED
  FALSE_POSITIVE
}

// Minimal safety-incident log — deliberately stores NO message content or free text.
model SafetyEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  surface     String   // "chat" | "self_talk" | "body_reset" | "bounce_back"
  triggerType String   // "helpline_response" | "needs_support" | "crisis_keyword" | "intensity_max"

  // ── Structured source references + founder review state (PR-6) ───────────
  // All nullable: existing rows predate this data and are left untouched.
  // Deliberately still no free-text field of any kind — never a raw message,
  // matched excerpt, or AI-generated summary.
  riskLevel      String?   // "high" | "medium" | "low" — from the deterministic screen
  sourceType     String?   // "chat_message" | "visualization_wizard" | "session_summary" | "weekly_report" | "debrief_legacy" | "debrief_structured" | "self_talk_generate" | "body_reset_arjun_note" | "profile_name"
  sourceRecordId String?   // id of the record that produced the screened text, when one is genuinely available
  chatSessionId  String?   // originating chat session, when the surface is chat-based
  userMessageId  String?   // originating Message id, when the surface is message-based

  reviewStatus  SafetyReviewStatus  @default(UNREVIEWED)
  reviewOutcome SafetyReviewOutcome?
  reviewedAt    DateTime?
  reviewedBy    String?   // founder identifier — no founder user table exists yet

  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([reviewStatus, createdAt])
}

// ── Coach-led plan system (Prompt 1 foundation) ─────────────────────────────
// A Plan is a coach-authored sequence of tool sessions. planType is a string
// (not an enum) so future weekly/monthly/ongoing coaching plans need no
// schema change. profileSnapshot freezes the User fields the generator saw,
// so a later profile edit doesn't silently rewrite why a plan was built.
model Plan {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  planType            String    @default("starter") // "starter" | "weekly" | "monthly" | "ongoing" (future)
  title               String
  status              String    @default("active")  // "active" | "completed" | "archived"
  currentSessionNum   Int       @default(1)

  primarySkillFocus   String?
  secondarySkillFocus String?
  coachNote           String?
  generatedReason     String?
  source              String    @default("onboarding")
  profileSnapshot     Json?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  completedAt         DateTime?

  sessions            PlanSession[]

  @@index([userId, status])
  @@index([userId, planType, createdAt])
}

model PlanSession {
  id                 String    @id @default(cuid())
  planId             String
  plan               Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  sessionNumber      Int
  title              String
  toolId             String    // "pressure_reset" | "focus_words" | ... (see services/planGenerator.js)
  toolRoute          String    // client route, e.g. "/body-reset"
  skillKey           String    // plan-level skill label, e.g. "pressure_control"
  durationMinutes    Int       @default(3)

  status             String    @default("locked") // "locked" | "today" | "done" | "skipped"
  personalizedReason String?
  coachInstruction   String?
  outputType         String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  completedAt        DateTime?

  @@index([planId, sessionNumber])
  @@index([planId, status])
}

model BodyResetSession {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode             String    // "quick" | "training"
  feeling          String?
  feelingCustom    String?
  context          String?
  contextCustom    String?
  focusWordUsed    String?
  tensionBefore    Int?
  readinessBefore  Int?
  tensionAfter     Int?
  readinessAfter   Int?
  cyclesCompleted  Int       @default(0)
  durationSeconds  Int       @default(0)
  arjunNote        String?
  arjunTags        Json?
  aiModel          String?
  completedAt      DateTime  @default(now())

  @@index([userId, completedAt])
}

// ── Coaching-cycle and prescription foundations (PR-8) ──────────────────────
// Database foundation for Arjun's core coaching loop (problem → barrier →
// one prescription → follow-up, docs/ARJUN-MVP-SPEC.md §2, §4.3-4.6).
// Additive only — no route, prompt, or chat-behavior changes ship in this PR.

enum CoachingCycleStatus {
  ACTIVE
  RESOLVED
  ABANDONED
}

// Whether the athlete has confirmed, corrected, or not yet responded to
// Arjun's barrier hypothesis for a cycle (§4.3 — "sounds like… does that fit?").
enum BarrierConfirmationStatus {
  PENDING
  CONFIRMED
  CORRECTED
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  SUPERSEDED
}

// The athlete's reported result for a prescribed Mental Rep (PR-13).
// NOT_TRIED is a genuine, replaceable outcome — the athlete may report a
// real outcome later, which supersedes it (see Prescription.outcomeStatus).
enum PrescriptionOutcomeStatus {
  HELPED
  HELPED_A_LITTLE
  DID_NOT_HELP
  NOT_TRIED
}

// One row per user — the anchor for whichever coaching cycle and
// prescription are currently "live" for that athlete. The actual active
// pointers live on ActiveCoachingSelection below (see its doc comment for
// why); this table only tracks that a state exists per user. Historical
// CoachingCycle/Prescription rows are never deleted or overwritten when the
// active selection moves on, and there is no automatic abandonment or
// expiry of it.
model UserCoachingState {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional 1:1 — absent entirely when the athlete has no active cycle.
  activeSelection ActiveCoachingSelection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Composite-relation target (never queried directly): lets
  // ActiveCoachingSelection's userCoachingState FK require the selection to
  // belong to both this same state row AND this same user — closing the
  // last gap where a selection could otherwise carry a userId belonging to
  // a different user than the state it's attached to.
  @@unique([id, userId])
}

// The active pointer previously lived directly on UserCoachingState as two
// independent nullable composite FKs (activeCycleId, activePrescriptionId).
// That design could not fully prevent a partial-null bypass: PostgreSQL's
// composite-FK matching (MATCH SIMPLE) skips the ownership check entirely
// as soon as ANY column in the FK is null, so a row with a non-null
// activePrescriptionId but a null activeCycleId would satisfy the
// (activePrescriptionId, activeCycleId, userId) FK trivially — the
// three-way check never ran at all.
//
// This model fixes that by making cycleId and userId REQUIRED here, with
// only prescriptionId nullable. A selection row exists at all only when
// there's an active cycle (cycleId can't be left unset), so "prescription
// active, no active cycle" can no longer be represented, let alone bypass a
// check — there's nowhere to store an active prescription without a cycle.
// When prescriptionId IS set, cycleId/userId are guaranteed present, so
// MATCH SIMPLE's null-column skip can only ever apply to prescriptionId
// itself — never a partial match on cycle/user.
model ActiveCoachingSelection {
  id String @id @default(cuid())

  // 1:1 back to the owning state row — at most one selection per state.
  // Composite FK: (userCoachingStateId, userId) → UserCoachingState(id,
  // userId) — a selection row cannot carry a userId different from the
  // state it belongs to. Without this, a selection's userId (used by the
  // cycle/prescription composite FKs below) could point to a different
  // user than its own userCoachingState, letting User A's state reference
  // User B's userId, cycle, or prescription.
  userCoachingStateId String            @unique
  userCoachingState   UserCoachingState @relation(fields: [userCoachingStateId, userId], references: [id, userId], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // At most one active selection per cycle. Composite FK: (cycleId, userId)
  // → CoachingCycle(id, userId) — the selected cycle must belong to userId.
  cycleId String
  cycle   CoachingCycle @relation("SelectedCycle", fields: [cycleId, userId], references: [id, userId], onDelete: Restrict)

  // At most one active selection per prescription. Composite FK:
  // (prescriptionId, cycleId, userId) → Prescription(id, cycleId, userId).
  // cycleId/userId are required fields on THIS row, so a non-null
  // prescriptionId always resolves the full triple — it can never bypass
  // cycle/user consistency via a null cycleId, because cycleId is simply
  // never null here.
  prescriptionId String?
  prescription   Prescription? @relation("SelectedPrescription", fields: [prescriptionId, cycleId, userId], references: [id, cycleId, userId], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Global: at most one active selection per cycle / per prescription.
  @@unique([cycleId])
  @@unique([prescriptionId])
  // Composite uniques required by Prisma as the exact-matching "one" side
  // of each composite relation above — add no constraint beyond the
  // singles (userCoachingStateId/cycleId/prescriptionId are already
  // globally unique here, so any composite that includes them is trivially
  // unique too).
  @@unique([userCoachingStateId, userId])
  @@unique([cycleId, userId])
  @@unique([prescriptionId, cycleId, userId])
}

// One historical record per problem cycle an athlete brings to Arjun: the
// real situation described, Arjun's single barrier hypothesis, and whether
// the athlete confirmed or corrected it (§4.3). Many cycles accumulate per
// user over time — only one is ever pointed to as "active", via
// UserCoachingState.activeCycleId.
model CoachingCycle {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The athlete's real performance problem or situation, as they described it.
  problemStatement String

  // Arjun's single barrier hypothesis (one of the seven barriers, §3.1) —
  // free text, not an enum, since the barrier is named conversationally and
  // the internal vocabulary may evolve without a schema change.
  barrierHypothesis         String
  barrierConfirmationStatus BarrierConfirmationStatus @default(PENDING)

  status CoachingCycleStatus @default(ACTIVE)

  // Optional originating chat session, when the cycle can be traced to one.
  sourceChatSessionId String?
  sourceChatSession   ChatSession? @relation(fields: [sourceChatSessionId], references: [id])

  prescriptions   Prescription[]           @relation("PrescriptionCycle")
  activeSelection ActiveCoachingSelection? @relation("SelectedCycle")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?
  abandonedAt DateTime? // set only on an explicit abandon action — never automatic

  @@index([userId, status])
  @@index([userId, createdAt])
  // Composite-relation target (never queried directly): lets Prescription's
  // (cycleId, userId) FK and ActiveCoachingSelection's (cycleId, userId) FK
  // both require the referenced cycle to be owned by that same userId.
  @@unique([id, userId])
}

// One prescribed practice within a coaching cycle (§3.2, §4.4). Stores the
// exact athlete-visible card content at prescription time so a later
// follow-up or Playbook entry can render byte-identical to what the athlete
// actually saw — cardContent is never regenerated or reconstructed from
// other fields. No expiry field exists; a prescription only leaves ACTIVE
// through an explicit completed/superseded transition.
model Prescription {
  id      String        @id @default(cuid())
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleId String
  // Composite FK: (cycleId, userId) → CoachingCycle(id, userId) — a
  // Prescription cannot reference a cycle owned by a different user. A
  // plain independent cycleId FK could not express this; the pair must
  // resolve together to one CoachingCycle row.
  cycle   CoachingCycle @relation("PrescriptionCycle", fields: [cycleId, userId], references: [id, userId], onDelete: Cascade)

  // Practice identity from the approved set (§3.2) — e.g. "pressure_reset",
  // "focus_cue_building". Free text, not an enum, matching the existing
  // skillKey/toolId convention (SkillProgress, PlanSession) so an addition
  // to the approved practice set never needs a schema change.
  practiceKey String

  // The athlete's real situation this practice was prescribed for.
  situation String

  // Exact athlete-visible practice/card content at prescription time.
  cardContent String

  cueWord String?

  status PrescriptionStatus @default(ACTIVE)

  // Optional originating chat session, when the prescription can be traced to one.
  sourceChatSessionId String?
  sourceChatSession   ChatSession? @relation(fields: [sourceChatSessionId], references: [id])

  activeSelection ActiveCoachingSelection? @relation("SelectedPrescription")

  prescribedAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  completedAt  DateTime?
  supersededAt DateTime? // set only on an explicit re-prescription — never automatic

  // Deterministic next-open follow-up opener (PR-11) — "Last time you
  // planned to try [practice] in [situation]. How did it go?", posted at
  // most once per prescription. followUpOpenerClaimedAt is the atomic
  // once-only claim guard (conditional update WHERE this is null — the
  // real duplicate-prevention guarantee, not a schema constraint);
  // followUpOpenerMessageId is the real persisted assistant Message id the
  // opener was written to, kept as a plain nullable scalar with no unique
  // constraint (a Message row is never shared across Prescriptions in
  // practice, but nothing here depends on the database enforcing that).
  // Plain scalars, not relations — a sourceChatSession-style named relation
  // on both models would be the only clean way to add one here, and isn't
  // needed for a nullable audit trail. No expiry, no automatic abandonment.
  followUpOpenerClaimedAt DateTime?
  followUpOpenerMessageId String?
  followUpOpenerSessionId String?

  // Reported outcome for this prescription (PR-13) — set at most once with
  // a final (non-NOT_TRIED) value; NOT_TRIED may later be replaced by a
  // real outcome. outcomeLesson is a short, athlete-visible statement only
  // — never the athlete's full raw reply (that already exists as the
  // persisted user Message referenced by outcomeSourceMessageId). No
  // score, rating, XP, streak, or reward field.
  outcomeStatus          PrescriptionOutcomeStatus?
  outcomeLesson          String?
  outcomeRecordedAt      DateTime?
  outcomeSourceMessageId String?
  outcomeSourceSessionId String?

  @@index([userId, status])
  @@index([cycleId])
  // Composite-relation target (never queried directly): lets
  // ActiveCoachingSelection's prescription FK require the active
  // prescription to belong to both this same user AND the selected cycle.
  @@unique([id, cycleId, userId])
}

// ── Adaptive onboarding (v2) — structured, versioned, server-authoritative ──
// Raw athlete answers only (selected IDs + custom text). No interpretation,
// scores, labels, or coaching prescriptions are ever stored here — those are
// produced in PR 3 from this raw data, never inside onboarding.
enum OnboardingStatus {
  IN_PROGRESS
  COMPLETED
}

model OnboardingSession {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  onboardingVersion Int               @default(2)
  attemptNumber     Int               @default(1)
  status            OnboardingStatus  @default(IN_PROGRESS)

  // Optimistic concurrency: every accepted PATCH increments revision.
  revision          Int               @default(0)
  currentStepId     String?           // stable SCREEN id (never a question id)
  branchId          String?           // resolved deep-branch id
  primaryPriorityId String?           // resolved primary-priority answer id

  // { [questionId]: { answerIds: string[], customText?: string } }
  answers           Json              @default("{}")

  startedAt         DateTime          @default(now())
  lastSavedAt       DateTime          @updatedAt   // informational only
  completedAt       DateTime?

  activeSlot        ActiveOnboardingSession?
  startingProfile   StartingPerformanceProfile?

  @@unique([userId, onboardingVersion, attemptNumber])
  @@index([userId, status])
  @@index([userId, onboardingVersion, status])
}

// One row per (userId, onboardingVersion). Its composite primary key makes it
// impossible for two IN_PROGRESS attempts of the same version to coexist:
// the second concurrent create hits a uniqueness error and the losing request
// reloads the winner. Deleted inside the completion transaction (a completed
// attempt holds no active slot) and cascades when its session is removed.
model ActiveOnboardingSession {
  userId            String
  onboardingVersion Int
  sessionId         String            @unique

  session           OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([userId, onboardingVersion])
}

// ── Starting Performance Profile (PR 3) ─────────────────────────────────────
// A cautious, rule-generated starting interpretation of the athlete's PR 2 raw
// answers. The canonical interpretation (ruleOutput/supportedObservations) is
// language-independent and deterministic; athlete-facing wording is rendered
// per language in StartingProfileWording. Raw answers in OnboardingSession are
// never modified. No scores, diagnoses, or personality claims are ever stored.
enum ProfileFitResponse {
  CONFIRMED
  PARTLY
  NOT_REALLY
}

enum ProfileWordingStatus {
  AI_OK
  FALLBACK_USED
}

model StartingPerformanceProfile {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  onboardingSessionId String            @unique
  onboardingSession   OnboardingSession @relation(fields: [onboardingSessionId], references: [id], onDelete: Cascade)

  profileVersion          Int @default(1)
  ruleVersion             Int @default(1)
  sourceOnboardingVersion Int
  sourceAttemptNumber     Int

  // Canonical, language-independent rule output (deterministic).
  ruleOutput            Json
  supportedObservations Json
  suggestedPriorityId   String

  // Athlete feedback (category C/D) — stored separately from the interpretation.
  fitResponse          ProfileFitResponse?
  correctionSelectedId String?
  correctionText       String?
  agreedPriorityId     String?

  // The single first coaching conversation (category E lives elsewhere).
  firstChatSessionId String?      @unique
  firstChatSession   ChatSession? @relation(fields: [firstChatSessionId], references: [id], onDelete: SetNull)

  generatedAt DateTime  @default(now())
  confirmedAt DateTime?
  updatedAt   DateTime  @updatedAt

  wordingVariants StartingProfileWording[]

  @@index([userId])
}

model StartingProfileWording {
  id        String                     @id @default(cuid())
  profileId String
  profile   StartingPerformanceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  language                  String // "en" | "hi"
  sections                  Json // { whatMatters, possiblePattern, whatHelps, whereWeBegin }
  wordingStatus             ProfileWordingStatus @default(FALLBACK_USED)
  deterministicFallbackUsed Boolean              @default(true)
  generatedAt               DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@unique([profileId, language])
}

// Where the athlete says they want to focus RIGHT NOW (PR: Performance
// Profile pathway). Deliberately separate from StartingPerformanceProfile:
// the starting profile is the frozen onboarding baseline (ruleOutput,
// suggestedPriorityId, agreedPriorityId, fitResponse, correction history)
// and is never rewritten when the athlete changes focus. This row is the
// only mutable part.
//
// At most one row per athlete — a change updates it in place rather than
// appending, so there is no history to grow unbounded. Nothing coaching-
// related is deleted by a focus change: CoachingCycles and Prescriptions
// are untouched, and the starting profile keeps every original field.
//
// Absent by design for existing athletes: the displayed focus falls back to
// the confirmed agreedPriorityId, so no backfill is needed and the row is
// created only when an athlete actually changes focus.
enum CurrentFocusSource {
  STARTING_PROFILE // derived from the confirmed agreedPriorityId
  ATHLETE_SELECTED // the athlete picked it on the profile screen
}

model CurrentCoachingFocus {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A stable difficult_moments answer id, or "different" when the athlete
  // wrote their own. Never a label, never localised.
  focusId String

  // Sanitised athlete text, only when focusId is "different". Bounded on
  // write; never logged.
  customText String?

  source CurrentFocusSource @default(ATHLETE_SELECTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Pilot Communications v1 ─────────────────────────────────────────────────
// Founder → pilot-athlete announcements and one-question structured surveys.
// Product/operational communication only — deliberately never fed into Coach
// context, Mind Journal, Arjun Review, ToolReport, Mental Rep, skill
// progression, XP, streaks, or safety interpretation (enforced on the read
// side in routes/pilotCommunications.js and founderPilotCommunications.js).
//
// "Pilot athlete" reuses the ONE existing, unqualified definition this
// codebase already has: every row in User (see routes/founderPilotOverview.js
// and routes/founder.js, both of which treat the full User table as the
// pilot population — there is no separate isPilot flag or pilot-membership
// model anywhere in this schema). No second concept of "pilot athlete" is
// introduced here.
enum PilotCommunicationType {
  ANNOUNCEMENT
  SURVEY
}

// Structured shapes only — v1 never stores free text from an athlete.
enum SurveyResponseType {
  YES_SOMEWHAT_NO
  RATING_1_5
  CUSTOM_SINGLE_CHOICE
}

model PilotCommunication {
  id   String                 @id @default(cuid())
  type PilotCommunicationType

  title String // founder-authored, plain text, max 100 chars (server-enforced)
  body  String // founder-authored, plain text, max 500 chars (server-enforced)

  // Optional CTA — an approved INTERNAL route only, checked at create-time
  // against a small server allowlist (founderPilotCommunications.js's
  // CTA_ROUTE_ALLOWLIST, sourced from client/src/App.jsx's live routes).
  // Never an arbitrary external URL — there is no column here that could
  // hold one.
  ctaRoute String?
  ctaLabel String? // max ~30 chars (server-enforced)

  // Audience choice captured at create time. "ALL" is re-resolved into
  // PilotCommunicationTarget rows at PUBLISH time (see that model's own
  // comment) so the snapshot reflects pilot membership as of publish, not
  // as of the draft. "SELECTED" targets are created immediately at create
  // time, since an explicit founder-picked athlete list has no such
  // staleness concern either way.
  audienceMode String // "ALL" | "SELECTED"

  // SURVEY only. A JSON string array — same convention already used for
  // User.goals / User.ritualSteps — only meaningful when
  // responseType === CUSTOM_SINGLE_CHOICE (2–5 short options,
  // server-enforced on write).
  responseType    SurveyResponseType?
  responseOptions String              @default("[]")

  isActive    Boolean   @default(false)
  publishedAt DateTime?

  targets   PilotCommunicationTarget[]
  responses PilotCommunicationResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, publishedAt])
}

// Explicit per-athlete targeting, one row per (communication, athlete) —
// never a loose JSON array of user ids. For "all pilot athletes" this is
// resolved and snapshotted ONCE at publish time (current User list at that
// moment), so a later-joining athlete never inherits an old communication
// and the founder's target/seen/response counts stay accurate against who
// was actually targeted. Publishing never re-resolves an already-published
// communication, so pilot-membership changes after publish never silently
// re-target it.
model PilotCommunicationTarget {
  id              String             @id @default(cuid())
  communicationId String
  communication   PilotCommunication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())

  @@unique([communicationId, userId])
  @@index([userId])
}

// One row per (communication, athlete) — seen / defer / dismiss / response
// state. Created lazily on the athlete's first interaction (no row yet means
// "not seen"). Deliberately has no free-text field anywhere on this model —
// see the safety note above the enum block: survey answers are always one
// of the three structured shapes, never athlete-authored text.
model PilotCommunicationResponse {
  id              String             @id @default(cuid())
  communicationId String
  communication   PilotCommunication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  seenAt DateTime? // set once, first time the popup was actually presented; never overwritten

  // Survey "Not now": 0 = never deferred, 1 = deferred once (still
  // eligible on a later visit), 2+ = the second "Not now" — dismissedAt is
  // also set at that point (permanent).
  deferCount Int @default(0)

  // Announcement: any dismiss. Survey: the second "Not now". Either way,
  // once set the communication is permanently ineligible for this athlete.
  dismissedAt DateTime?

  // Structured response only — "yes" | "somewhat" | "no", "1".."5", or one
  // of the communication's own responseOptions, depending on the
  // communication's responseType. Never free text. Answers are not
  // editable in v1: once respondedAt is set, this value does not change.
  responseValue String?
  respondedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([communicationId, userId])
  @@index([userId])
}

// ── Push Notifications v1 ─────────────────────────────────────────────────
// Optional, athlete-controlled Web Push reminders. One routine performance
// reminder per athlete per local calendar day, at most — see
// services/pushScheduler.js for the send-decision logic these two models
// exist to support. Deliberately separate from PilotCommunication in every
// respect (own models, own routes, own scheduler) — no cross-reference.

// One row per athlete — the daily send decision (§ lastSentLocalDate) is
// athlete-level, not per-device, so it belongs here rather than on
// PushSubscription (an athlete may have several).
model PushNotificationPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  enabled Boolean @default(false)

  // "HH:MM", 24-hour, local to `timezone` below — server-validated on
  // write. Null until the athlete has ever chosen a time.
  reminderTime String?
  // IANA timezone (e.g. "Asia/Kolkata"), captured client-side via
  // Intl.DateTimeFormat().resolvedOptions().timeZone at enable/update
  // time — never inferred from IP, language, or country. Server-validated
  // against the runtime's own supported-zone list on write.
  timezone     String?

  // "YYYY-MM-DD" in the athlete's own `timezone` — the one thing that
  // makes "at most one reminder per athlete per local day" durable across
  // restarts and overlapping scheduler sweeps. Set only after at least one
  // subscription actually accepts the push that day (see pushScheduler.js)
  // — a day where every send fails transiently leaves this unset, so a
  // later sweep the same day may still retry.
  lastSentLocalDate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per subscribed browser/device. A single athlete may have several
// (phone + desktop, or a re-installed PWA) — all are sent to on a due day.
// Never hard-deleted automatically; a terminal push-service error (404/410)
// sets disabledAt instead, preserving the audit trail and never racing a
// legitimate re-subscribe.
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The push service URL itself — inherently unique per device+browser+
  // install (issued by the browser's push service, e.g. fcm.googleapis.com/...).
  // Globally unique, not scoped to userId: two users can never legitimately
  // share one endpoint, and re-subscribing the same browser updates this
  // same row rather than creating a duplicate.
  endpoint String @unique
  p256dh   String
  auth     String

  // Set on a terminal (404/410) push-service response, or when the athlete
  // disables notifications from that specific browser (logout, or the
  // "Turn off notifications" action's current-device disable). A disabled
  // subscription is never sent to and never deleted automatically.
  disabledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ── Founder Email Center v1 ────────────────────────────────────────────────
// Founder-authored, founder-triggered product/beta emails to pilot
// athletes, sent through the existing Resend integration (services/email.js)
// — NOT a second email provider, NOT an inbox, NOT reply threading. Reuses
// the same "no separate pilot-membership system" rule PilotCommunication
// already documents above: "ALL" audience is the full User table, resolved
// once at send time. Deliberately separate from PilotCommunication in every
// respect (own models, own routes, own send path) — no cross-reference, and
// email content is never derived from Coach/Mind Journal/safety data (see
// routes/founderEmail.js — it only ever reads User.id/name/email).
//
// A "Send test to myself" action (routes/founderEmail.js) never creates
// either row below — it's a stateless one-off send to the founder's own
// configured test address, same convention as founderPushTest.js's test
// send never creating a PilotCommunication row.
model FounderEmailCampaign {
  id String @id @default(cuid())

  fromName    String  // display name only — the sender address itself stays the existing verified RESEND_FROM_EMAIL
  subject     String
  previewText String?
  body        String  // founder-authored; paragraphs + "**heading**" lines + "- " bullets only — see services/founderEmail.js's renderBodyHtml() for the exact small, non-HTML markup this supports. This IS the body snapshot: campaigns are never edited after creation.
  ctaLabel    String?
  ctaRoute    String? // internal route only, validated against the same CTA_ROUTE_ALLOWLIST services/pilotCommunications.js already exports — never an external URL

  audienceMode String // "ALL" | "SELECTED" — same convention as PilotCommunication.audienceMode

  createdAt DateTime  @default(now())
  sentAt    DateTime? // set once sending starts (there is no draft-save or scheduling step in v1 — POST /send validates, resolves the audience, and sends in one call)

  deliveries FounderEmailDelivery[]

  @@index([createdAt])
}

// DELIVERED/BOUNCED require the Resend webhook, which v1 does not add (see
// routes/founderEmail.js's module comment) — those two values exist here so
// the schema doesn't need another migration once that follow-up ships, but
// nothing in this PR ever writes them. SENT/FAILED are the only statuses
// v1 actually produces, decided synchronously from the Resend API response.
enum FounderEmailDeliveryStatus {
  SENT
  FAILED
  DELIVERED
  BOUNCED
}

// One row per (campaign, athlete) — never a loose recipient list. Every
// athlete gets their own individual Resend send (see routes/founderEmail.js)
// rather than one call with every address in To/CC, so no athlete's email
// is ever exposed to another.
model FounderEmailDelivery {
  id         String               @id @default(cuid())
  campaignId String
  campaign   FounderEmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  email           String  // snapshot of the athlete's email at send time — survives a later email change
  resendMessageId String?
  status          FounderEmailDeliveryStatus

  sentAt      DateTime?
  deliveredAt DateTime? // reserved — see FounderEmailDeliveryStatus doc comment; never written in v1
  bouncedAt   DateTime? // reserved — see FounderEmailDeliveryStatus doc comment; never written in v1
  failedAt    DateTime?
  openedAt    DateTime? // reserved for a later webhook PR — never inferred, never written in v1
  clickedAt   DateTime? // reserved for a later webhook PR — never inferred, never written in v1

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([userId])
}
